POSTGRES_IMAGE=postgres:16
DATABASE_URL=postgresql+asyncpg://dam:dam@localhost:5432/dam

# Адреса API: лише loopback (127.0.0.1, ::1, localhost), інакше запуск відмовить
# API_HOST=127.0.0.1
# API_PORT=8000
# Лише для Docker: дозволяє API_HOST=0.0.0.0 усередині контейнера (межу тримають порти compose
# на 127.0.0.1). Поза контейнером запуск із цією змінною відмовить. Задається в docker-compose.yml.
# API_IN_CONTAINER=1

# Сповіщення Telegram: токен від @BotFather. Без нього сповіщення вимкнені, збір працює як завжди.
# TELEGRAM_BOT_TOKEN=
